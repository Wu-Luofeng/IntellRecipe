#!/bin/bash
echo "=== 1. 从外部IP测试（模拟浏览器） ==="
RESP=$(curl -s -w "\nHTTP_CODE:%{http_code}" -X POST "http://129.204.203.184/api/admin/ingredient" \
  -H "Content-Type: application/json" \
  -H "Origin: http://129.204.203.184" \
  -d '{"name":"外部测试食材","caloriesPer100g":100,"description":"测试","nutritionValue":"","image":""}')
echo "$RESP"

echo ""
echo "=== 2. 模拟浏览器发送空字符串字段 ==="
RESP2=$(curl -s -w "\nHTTP_CODE:%{http_code}" -X POST "http://129.204.203.184/api/admin/ingredient" \
  -H "Content-Type: application/json" \
  -d '{"name":"空字段测试","caloriesPer100g":100,"description":"","nutritionValue":"","image":"","type":"","weight":"","unit":"","calories":""}')
echo "$RESP2"

echo ""
echo "=== 3. 查看item-service日志中的ERROR/Exception ==="
grep -n -i "error\|exception\|500" /home/ubuntu/IntellRecipe/logs/item-service.log | tail -30

echo ""
echo "=== 4. 查看Nginx错误日志 ==="
tail -20 /var/log/nginx/error.log 2>/dev/null || docker logs nginx --tail 20 2>&1 || echo "无法获取nginx日志"

echo ""
echo "=== 5. 清理测试数据 ==="
curl -s -X DELETE "http://localhost:8082/admin/ingredient/60" > /dev/null
curl -s -X DELETE "http://localhost:8082/admin/ingredient/61" > /dev/null
echo "已清理"